<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/payment_item_margin"
    android:background="@drawable/payment_item_background"
    android:padding="16dp">

    <!-- Status -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_full_name"
        app:layout_constraintEnd_toStartOf="@+id/icon_sync_status"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:background="@color/status_current_container"
            tools:text="ACTIVE"
            tools:textColor="@color/status_current_text" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Sync Status Icon -->
    <ImageView
        android:id="@+id/icon_sync_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Sync Status"
        app:layout_constraintBottom_toBottomOf="@+id/text_full_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_cloud_done" />

    <!-- Name -->
    <TextView
        android:id="@+id/text_full_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/card_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Miguel B" />

    <!-- Contact details -->
    <TextView
        android:id="@+id/text_contact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_full_name"
        tools:text="1234567890 · email@example.com" />

    <!-- Joined Date -->
    <TextView
        android:id="@+id/text_joined_on"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/ic_calendar"
        app:drawableTint="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_contact"
        tools:text="Joined on 2023-10-26" />

    <!-- Tariff Chip Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tariff_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/latest_payment_box"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_joined_on"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/text_tariff_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Tarifa general" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Member Actions Row -->
    <LinearLayout
        android:id="@+id/member_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_tariff_badge">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_tariff"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="38dp"
            android:paddingHorizontal="8dp"
            android:text="Tarifa"
            android:textSize="12sp"
            app:cornerRadius="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_edit_member"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="38dp"
            android:paddingHorizontal="8dp"
            android:text="✏️ Editar"
            android:textSize="12sp"
            app:cornerRadius="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_member"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="38dp"
            android:paddingHorizontal="8dp"
            android:text="🗑️ Eliminar"
            android:textColor="@color/status_expired_text"
            android:textSize="12sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/status_expired_text" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
